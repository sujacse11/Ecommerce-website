# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-change-me-for-production-key-123456
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Settings (PostgreSQL / Supabase)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=ecommerce_db
DB_USER=postgres
DB_PASSWORD=postgres_password
DB_HOST=db
DB_PORT=5432
# DB_URL=postgresql://user:pass@host:5432/dbname (for Supabase/Render)

# CORS & Frontend URLs
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# JWT Configuration
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Email Settings (SMTP stub or real)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@ecommerce.com
EMAIL_HOST_PASSWORD=emailpassword

# Payment Keys (Stripe & Razorpay)
STRIPE_PUBLIC_KEY=pk_test_sample
STRIPE_SECRET_KEY=sk_test_sample
STRIPE_WEBHOOK_SECRET=whsec_sample
RAZORPAY_KEY_ID=rzp_test_sample
RAZORPAY_KEY_SECRET=rzp_secret_sample

# AI Chatbot Credentials (OpenAI / Gemini optional key)
OPENAI_API_KEY=sk-proj-sample-key
GEMINI_API_KEY=AIzaSySampleKey

# Cloudinary Storage Credentials (Optional)
CLOUDINARY_CLOUD_NAME=sample_cloud
CLOUDINARY_API_KEY=123456789
CLOUDINARY_API_SECRET=sample_secret

# Vite Frontend Envs
VITE_API_BASE_URL=http://localhost:8000/api/v1
